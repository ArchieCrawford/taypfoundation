---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CloseBand from "../components/CloseBand.astro";
import { programs } from "../data/site";

const title = "Programs | TAYP Foundation";
const description =
  "Student media credentials, camps and clinics, gear drives, and scholarships from TAYP Foundation. Several programs are still coming soon.";
---

<Base title={title} description={description}>
  <PageHero
    kicker="Programs"
    title="Four ways we give the work back."
    lede="Each of these is part of the mission. Where a door is not open yet, we have marked it coming soon."
  />

  <section class="section">
    <div class="wrap stack">
      {
        programs.map((program) => (
          <article class="panel program" id={program.id} aria-labelledby={`${program.id}-title`}>
            <p class="badge">Coming soon</p>
            <h2 id={`${program.id}-title`}>{program.title}</h2>
            {
              program.paragraphs.map((paragraph) => (
                <p class="note">{paragraph}</p>
              ))
            }
          </article>
        ))
      }
    </div>
  </section>

  <CloseBand />
</Base>
