---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";

const title = "Page not found | TAYP Foundation";
const description = "That page is not on the TAYP Foundation site.";
---

<Base title={title} description={description} noindex={true}>
  <PageHero
    kicker="404"
    title="We can’t find that page."
    lede="The link may have changed, or it was never on the roster. Let’s get you back to something real."
  />
  <section class="section">
    <div class="wrap cta-row">
      <a class="btn" href="/">Home</a>
      <a class="btn btn-ghost" href="/contact/">Contact</a>
    </div>
  </section>
</Base>
